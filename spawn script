using UnityEngine;

public class Spawnerscript : MonoBehaviour
{
    [SerializeField] GameObject objectToSpawn;
    void Start()
    {
        InvokeRepeating("Spawn", 1, 2);
    }

    void Spawn()
    {
        Instantiate(objectToSpawn, new Vector3(Random.Range(-4, 4), 5, 0), Quaternion.identity);
    }
}
